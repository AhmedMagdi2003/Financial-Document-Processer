{
  "name": "Google Drive to Financial Document Processor",
  "flow": [
    {
      "id": 1,
      "module": "google-drive:watchFilesInAFolder",
      "version": 1,
      "parameters": {
        "select": "folder",
        "folderId": "1p9CN6bctZzHetn2lnYC0Ju6ipp6EBvIg",
        "limit": 10
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch Invoices in Folder"
        }
      }
    },
    {
      "id": 2,
      "module": "google-drive:downloadAFile",
      "version": 1,
      "parameters": {},
      "mapper": {
        "fileId": "{{1.id}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Download Invoice / Receipt"
        }
      }
    },
    {
      "id": 3,
      "module": "http:makeAMultipartFormDataRequest",
      "version": 1,
      "parameters": {
        "handleErrors": false,
        "useCustomHeaders": true
      },
      "mapper": {
        "url": "https://uncross-verbally-evidence.ngrok-free.dev/api/v1/documents",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "tok_ahmed_magdi_TNOW-swIAYIlF2w3oNiMdXFn5vdgxy7r"
          },
          {
            "name": "ngrok-skip-browser-warning",
            "value": "true"
          }
        ],
        "fields": [
          {
            "name": "project_id",
            "value": "river"
          },
          {
            "name": "auto_record",
            "value": "true"
          },
          {
            "name": "file",
            "file": "{{2.data}}",
            "filename": "{{1.title}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Upload to Financial Document Processor"
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "description": "Watches a Google Drive folder for new receipts/invoices and automatically uploads them to your Financial Document Processor backend for AI extraction and automatic recording."
  }
}
