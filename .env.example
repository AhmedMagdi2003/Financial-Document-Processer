# Production / Cloud mode connected to Supabase PostgreSQL
MODE=cloud
DATABASE_URL=postgresql+psycopg://postgres.gwbviyloycizoxsktuhe:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://gwbviyloycizoxsktuhe.supabase.co
STORAGE_BUCKET=originals

# Reviewer authentication and session security (generate distinct secrets >= 24 chars)
REVIEWER_TOKEN=your-secure-reviewer-token-here-minimum-24-chars
SESSION_SECRET=your-secure-session-secret-here-minimum-24-chars
SECURE_COOKIES=false

# AI Model Provider: "gemini", "openai", or "xai"
PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# Provider API Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Execution Limits
MAX_LLM_CALLS=3
MAX_JOB_COST_USD=0.10
MAX_INPUT_TOKENS=32000

# Cost Accounting / Pricing Guard (required when calling live LLMs)
INPUT_USD_PER_MILLION=0.10
OUTPUT_USD_PER_MILLION=0.40
PRICING_SOURCE_URL=https://ai.google.dev/pricing
PRICING_CHECKED_AT=2026-10-21

# Automated Processing (auto-record valid documents without manual confirmation)
AUTO_RECORD=true

# Google Sheets Sync (100% Free Google Apps Script Webhook)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
SHEETS_WEBHOOK_SECRET=your-sheets-webhook-secret-matches-reviewer-token

# Hosting Provider Switcher: "ngrok", "render", or "local"
HOSTING_PROVIDER=ngrok
RENDER_URL=https://financial-document-processor.onrender.com
NGROK_AUTHTOKEN=
NGROK_URL=https://your-ngrok-tunnel.ngrok-free.app
PUBLIC_BASE_URL=
