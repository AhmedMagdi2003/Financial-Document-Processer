# Cloud is authoritative; demo must be explicitly selected for local SQLite/fixtures.
MODE=cloud
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=originals
# Generate distinct random values of at least 24 characters; never commit .env.
REVIEWER_TOKEN=
SESSION_SECRET=
SECURE_COOKIES=true
PROVIDER=none
MODEL_NAME=
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MAX_LLM_CALLS=3
MAX_JOB_COST_USD=0.10
# Live calls require explicit, model-specific token rates and provenance.
# Use the provider's current price page; unknown rates must not become zero.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
PRICING_SOURCE_URL=
PRICING_CHECKED_AT=
MAX_INPUT_TOKENS=32000
PUBLISHER_URL=http://127.0.0.1:8011
PUBLISHER_SECRET=
SHEETS_SPREADSHEET_ID=
SHEETS_ACCESS_TOKEN=
TRACING_BACKENDS=none
